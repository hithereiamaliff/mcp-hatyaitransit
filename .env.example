# Hat Yai Transit MCP Server - environment variables
# Copy to .env for local use:  cp .env.example .env
# (On the VPS the deploy workflow writes .env from the GitHub secret HYT_API_KEY.)

# Hat Yai Transit API base URL (default: the public API)
HYT_API_URL=https://hatyaitransit.techmavie.digital

# API key sent as the X-API-Key header. Optional, but without it:
#   - plan_journey and search_places are disabled
#   - all users of this server share the keyless limit of 60 requests/minute per IP
# The MCP *service key* enables everything. It must also be listed on the API server in
# API_SERVICE_KEYS as  mcp:<the same key>. Generate one with:  openssl rand -hex 32
# A developer key (hyt_...) from https://hatyaitransit.techmavie.digital/developers.html
# works too, but allows the journey planner only (no place search).
HYT_API_KEY=

# How long to wait for the API, in milliseconds (default 15000)
HYT_API_TIMEOUT_MS=15000

# HTTP server only (npm start / Docker). Not used by the stdio entry point.
PORT=8080
HOST=0.0.0.0
